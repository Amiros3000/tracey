# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/
ENV/

# Environment variables — never commit real secrets
.env

# Database files — never commit the encrypted DB either (it's user data)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Cryptographic keys
*.key
*.pem
*.p12
*.pfx

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Logs
*.log
logs/

# Coverage / testing artifacts
.coverage
htmlcov/
.pytest_cache/

# Build
dist/
build/
*.egg-info/
