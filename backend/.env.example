# ─── JWT ─────────────────────────────────────────────────────────────────────
# Signing key for all JWT tokens. Generate with:
#   openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLCipher encryption key. Generate with:
#   openssl rand -hex 32
# WARNING: if you lose this key, the database is unrecoverable.
# Store a backup of this key in a password manager.
DATABASE_KEY=your_database_key_here

# Path to the SQLite/SQLCipher database file (relative to backend/)
DATABASE_PATH=tracey.db

# ─── AI ───────────────────────────────────────────────────────────────────────
# OpenRouter API key — required for dashboard insights, PDF parsing, product lookup
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Anthropic API key — optional, only needed for AI chat + scanned PDF fallback
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Email ────────────────────────────────────────────────────────────────────
# Resend API key — optional, only needed for email verification emails
# Get one at: https://resend.com
RESEND_API_KEY=re_your_key_here

# Sender address shown in verification emails
FROM_EMAIL=tracey <noreply@yourdomain.com>

# Frontend URL — used in verification email links
FRONTEND_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev:  http://localhost:3000
# Prod: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=200
