# ─── JWT ────────────────────────────────────────────────────────────────────
# Signing key for all JWT tokens. Generate with:
#   openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_GENERATED_KEY

# ─── Database ────────────────────────────────────────────────────────────────
# SQLCipher encryption key. Generate with:
#   openssl rand -hex 32
# WARNING: if you lose this key, the database is unrecoverable.
# Store a backup of this key in a password manager.
DATABASE_KEY=REPLACE_WITH_GENERATED_KEY

# Path to the SQLite/SQLCipher database file (relative to backend/)
DATABASE_PATH=tracey.db

# ─── AI ──────────────────────────────────────────────────────────────────────
# Anthropic API key — used for product lookup and AI money guide
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev:  http://localhost:3000
# Prod: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Requests per minute per IP for standard endpoints.
# Auth endpoints use stricter limits defined in the route handlers.
RATE_LIMIT_PER_MINUTE=200
